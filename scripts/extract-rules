#!/usr/bin/env python3
"""extract-rules — generate <book>/RULES.md from book topic references.

Selects skill directories whose SKILL.md frontmatter marks a book via
`metadata.book` (string "true"/"yes") or, during transition, top-level
`book:`. Iterates only those dirs' references/*.md. Emits one RULES.md
per book, outside references/, so this script never ingests its own output.

Usage:
    scripts/extract-rules           # write RULES.md for every book
    scripts/extract-rules --check   # exit 1 on drift or disappeared ids

Retirement: do not delete an id. Leave the bare id in the topic
## Rules block and rewrite the body to "Superseded by <book>/<PREFIX>-nn".
Drop that rule's check: and tag:. Write and --check then stay green
because the id did not disappear. RULES.md is generated; never edit it
to forget an id. There is no --retire flag.
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

MARKER = "<!-- GENERATED by scripts/extract-rules — do not edit -->"
CONTRACT_FILES = frozenset({"specialization.md", "verification.md"})
ID_RE = re.compile(r"^([A-Z][A-Z0-9]*)-(\d{2,})\b")
FRONTMATTER_RE = re.compile(r"^---\n(.*?)\n---\n", re.S)
QUALIFIED_ID_RE = re.compile(r"(?m)^([A-Za-z0-9_-]+/[A-Z][A-Z0-9]*-\d{2,})\b")


def repo_root() -> Path:
    return Path(__file__).resolve().parent.parent


def parse_frontmatter(text: str) -> dict[str, str]:
    match = FRONTMATTER_RE.match(text)
    if not match:
        return {}
    fields: dict[str, str] = {}
    for line in match.group(1).splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        fields[key.strip()] = value.strip()
    return fields


def is_book(skill_md: Path) -> bool:
    # Line-splitter is indentation-blind: nested `metadata: / book: "true"`
    # still lands in fields["book"]. Top-level `book:` is accepted the same way
    # during transition. There is no dotted `metadata.book` key.
    fm = parse_frontmatter(skill_md.read_text(encoding="utf-8"))
    raw = fm.get("book") or ""
    return raw.strip("\"'").lower() in {"true", "yes", "1"}


def book_scope(skill_md: Path) -> str:
    # `metadata.scope: "cross-cutting"` marks a book disclosed alongside the
    # per-PBI language book. Absent scope keeps the language-book meaning.
    fm = parse_frontmatter(skill_md.read_text(encoding="utf-8"))
    raw = (fm.get("scope") or "").strip("\"'").lower()
    return raw or "language"


def discover_books(skills_root: Path) -> list[Path]:
    books: list[Path] = []
    for skill_md in sorted(skills_root.glob("*/SKILL.md")):
        if is_book(skill_md):
            books.append(skill_md.parent)
    return books


def section_body(text: str, heading: str) -> str | None:
    pattern = re.compile(rf"(?ms)^## {re.escape(heading)}\s*\n(.*?)(?=^## |\Z)")
    match = pattern.search(text)
    if not match:
        return None
    return match.group(1)


def parse_rules(path: Path, book: str) -> list[dict]:
    text = path.read_text(encoding="utf-8")
    rules_body = section_body(text, "Rules")
    if rules_body is None:
        raise SystemExit(f"{path}: topic reference is missing a ## Rules section")
    if section_body(text, "How") is None:
        raise SystemExit(f"{path}: topic reference is missing a ## How section")

    rules: list[dict] = []
    current: dict | None = None
    body_lines: list[str] = []

    def finish() -> None:
        nonlocal current, body_lines
        if current is None:
            return
        if not body_lines:
            raise SystemExit(f"{path}: {current['bare_id']} has no rule text")
        if len(body_lines) > 3:
            raise SystemExit(
                f"{path}: {current['bare_id']} has {len(body_lines)} body lines "
                f"(max 3; check:/tag: excluded)"
            )
        current["text"] = " ".join(line.strip() for line in body_lines)
        rules.append(current)
        current = None
        body_lines = []

    for raw in rules_body.splitlines():
        line = raw.rstrip()
        stripped = line.strip()
        if not stripped:
            continue
        id_match = ID_RE.match(stripped)
        if id_match:
            finish()
            prefix, number = id_match.group(1), id_match.group(2)
            rest = stripped[id_match.end():].strip()
            current = {
                "bare_id": f"{prefix}-{number}",
                "qualified": f"{book}/{prefix}-{number}",
                "prefix": prefix,
                "check": None,
                "tag": None,
                "topic": path.stem,
            }
            body_lines = [rest] if rest else []
            continue
        if current is None:
            raise SystemExit(f"{path}: Rules text before first id: {stripped!r}")
        if stripped.startswith("check:"):
            if current["check"] is not None:
                raise SystemExit(f"{path}: {current['bare_id']} has more than one check:")
            current["check"] = stripped[len("check:"):].strip()
            continue
        if stripped.startswith("tag:"):
            if current["tag"] is not None:
                raise SystemExit(f"{path}: {current['bare_id']} has more than one tag:")
            current["tag"] = stripped[len("tag:"):].strip()
            continue
        body_lines.append(stripped)

    finish()
    if not rules:
        raise SystemExit(f"{path}: ## Rules section contains no rule ids")
    return rules


def collect_book(book_dir: Path) -> list[dict]:
    book = book_dir.name
    refs = book_dir / "references"
    if not refs.is_dir():
        raise SystemExit(f"{book_dir}: book is missing references/")
    rules: list[dict] = []
    seen: set[str] = set()
    for path in sorted(refs.glob("*.md")):
        if path.name in CONTRACT_FILES:
            continue
        for rule in parse_rules(path, book):
            if rule["bare_id"] in seen:
                raise SystemExit(f"{book}: duplicate rule id {rule['bare_id']}")
            seen.add(rule["bare_id"])
            rules.append(rule)
    return rules


def render(book: str, rules: list[dict]) -> str:
    lines = [MARKER, "", f"# {book} — Rules projection", ""]
    current_topic = None
    for rule in rules:
        if rule["topic"] != current_topic:
            current_topic = rule["topic"]
            lines.append(f"## {current_topic}")
            lines.append("")
        lines.append(f"{rule['qualified']}  {rule['text']}")
        if rule["tag"]:
            lines.append(f"            tag: {rule['tag']}")
        if rule["check"]:
            lines.append(f"            check: {rule['check']}")
        lines.append("")
    return "\n".join(lines)


def committed_ids(path: Path) -> set[str]:
    if not path.is_file():
        return set()
    return set(QUALIFIED_ID_RE.findall(path.read_text(encoding="utf-8")))


def write_or_check(book_dir: Path, rendered: str, check: bool) -> int:
    dest = book_dir / "RULES.md"
    previous = committed_ids(dest)
    new_ids = set(QUALIFIED_ID_RE.findall(rendered))
    disappeared = sorted(previous - new_ids)
    if check:
        failed = 0
        if disappeared:
            print(f"{dest}: disappeared rule ids (append-only): {', '.join(disappeared)}", file=sys.stderr)
            failed = 1
        if dest.is_file():
            existing = dest.read_text(encoding="utf-8")
            if existing != rendered:
                print(f"{dest}: drift from scripts/extract-rules", file=sys.stderr)
                failed = 1
        else:
            print(f"{dest}: missing generated RULES.md", file=sys.stderr)
            failed = 1
        return failed
    if disappeared:
        print(f"{dest}: disappeared rule ids (append-only): {', '.join(disappeared)}", file=sys.stderr)
        return 1
    dest.write_text(rendered, encoding="utf-8")
    print(f"  wrote {dest.relative_to(repo_root())} ({len(new_ids)} rules)")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="diff against committed RULES.md")
    args = parser.parse_args()
    root = repo_root()
    skills_root = root / ".agents" / "skills"
    books = discover_books(skills_root)
    if not books:
        print("extract-rules: no book: true skills found", file=sys.stderr)
        return 1
    failed = 0
    for book_dir in books:
        rules = collect_book(book_dir)
        rendered = render(book_dir.name, rules)
        failed |= write_or_check(book_dir, rendered, args.check)
    if args.check and failed == 0:
        print(f"rules-check: {len(books)} book(s) clean")
    return failed


if __name__ == "__main__":
    sys.exit(main())
