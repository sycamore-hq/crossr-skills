#!/usr/bin/env python3
"""Mechanical plan-gate audit. No LLM.

Checks bidirectional AC↔claim coverage, the 30% judgment quota, append-only
id integrity, and preserve-vs-grow (rule 5). When an evidence packet is
named, every gap and preservation constraint must be a claim.

Also checks the `## System-design applicability` declaration against the
topic keys of the disclosed cross-cutting books: every key exactly once,
`applies` or `n/a — <reason>`, before `## Phases`. Keys come from the
rule ids in each book's RULES.md, minus its `applicability` topic.

Usage:
  ./scripts/audit-plan [--loc-threshold N] [--rules RULES.md ...] <plan.md>

`--rules` names the disclosed cross-cutting RULES.md files (repeatable);
the conductor passes exactly the set it disclosed to the planner. Without
it, every cross-cutting book in this catalog is used, which is the set the
harness discloses from a pin of this catalog. A disclosed file must belong
to a cross-cutting book, yield at least one topic key, and appear once.

`--loc-threshold N` fails any phase whose `- est. LOC:` is missing,
unparsable, or exceeds N. No flag, no check. Exit 0 on pass, 1 on fail,
2 on usage error.
Calculations are pure; loading the file is the action.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path

JUDGMENT_QUOTA = 0.30
PRESERVE_NONE = "none — no prior verified record"
CLAIM_TYPES = frozenset({"mechanical", "observable", "judgment"})

HEADING_RE = re.compile(r"^# Plan:\s+(\S+)\s*$")
AC_RE = re.compile(r"^- (AC-\d+):\s+(.+)$")
CLAIM_RE = re.compile(
    r"^- (C-\d+)(?:\s+\[(superseded)\])?:\s+"
    r"(mechanical|observable|judgment)\s+·\s+"
    r"(AC-\d+(?:,\s*AC-\d+)*)\s+·\s+(.+)$"
)
PRESERVE_ITEM_RE = re.compile(r"^- (PV-\d+)\s+→\s+(C-\d+):\s+(.+)$")
GAP_MAP_RE = re.compile(r"^- gap (G-\d+)\s+→\s+(C-\d+)")
PRESERVE_MAP_RE = re.compile(r"^- preserve (PV-\d+)\s+→\s+(C-\d+)")
PACKET_PATH_RE = re.compile(r"^- path:\s+(\S+)")
PHASE_RE = re.compile(r"^### Phase\s+(\d+)")
EST_LOC_RE = re.compile(r"^- est\. LOC:\s+(\d+)")
SECTION_RE = re.compile(r"^## (.+)$")
APPLICABILITY = "System-design applicability"
APPLICABILITY_TOPIC = "applicability"
DECLARATION_RE = re.compile(r"^- ([A-Z][A-Z0-9]*):\s*(.*)$")
NA_PREFIX = "n/a —"
RULES_TOPIC_RE = re.compile(r"^## (\S+)\s*$")
RULES_ID_LINE_RE = re.compile(r"^([A-Za-z0-9_-]+)/(\S+)")
RULES_ID_RE = re.compile(r"^([A-Z][A-Z0-9]*)-(\d{2,})$")


@dataclass(frozen=True)
class Claim:
    cid: str
    typ: str
    acs: tuple[str, ...]
    text: str
    superseded: bool = False


@dataclass(frozen=True)
class Acceptance:
    aid: str
    text: str


@dataclass(frozen=True)
class PreserveItem:
    pid: str
    claim: str
    text: str


@dataclass(frozen=True)
class GapMap:
    gid: str
    claim: str


@dataclass(frozen=True)
class Declaration:
    key: str
    status: str


@dataclass
class Phase:
    num: int
    est_loc: int | None = None


@dataclass
class Plan:
    pbi: str
    acs: list[Acceptance] = field(default_factory=list)
    claims: list[Claim] = field(default_factory=list)
    preserve: list[PreserveItem] = field(default_factory=list)
    preserve_maps: list[PreserveItem] = field(default_factory=list)
    preserve_none: bool = False
    gaps: list[GapMap] = field(default_factory=list)
    evidence_path: str | None = None
    phases: list[Phase] = field(default_factory=list)
    has_questions: bool = False
    sections: list[str] = field(default_factory=list)
    declarations: list[Declaration] = field(default_factory=list)
    malformed_declarations: list[str] = field(default_factory=list)


def parse_ac_list(raw: str) -> tuple[str, ...]:
    return tuple(part.strip() for part in raw.split(",") if part.strip())


def parse_plan(text: str) -> Plan:
    """Parse a plan artifact. Unknown lines and fenced blocks are ignored."""
    plan = Plan(pbi="")
    section = ""
    in_fence = False
    for raw in text.splitlines():
        line = raw.rstrip()
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        heading = HEADING_RE.match(line)
        if heading:
            plan.pbi = heading.group(1)
            continue
        sec = SECTION_RE.match(line)
        if sec:
            section = sec.group(1).strip()
            plan.sections.append(section)
            if section == "Unresolved questions":
                plan.has_questions = True
            continue
        if section == APPLICABILITY:
            if line.startswith("- "):
                m = DECLARATION_RE.match(line)
                if m:
                    plan.declarations.append(Declaration(m.group(1), m.group(2)))
                else:
                    plan.malformed_declarations.append(line)
            continue
        if section == "Phases":
            phase = PHASE_RE.match(line)
            if phase:
                plan.phases.append(Phase(int(phase.group(1))))
                continue
            loc = EST_LOC_RE.match(line)
            if loc and plan.phases:
                plan.phases[-1].est_loc = int(loc.group(1))
                continue
        if section == "Acceptance Criteria":
            m = AC_RE.match(line)
            if m:
                plan.acs.append(Acceptance(m.group(1), m.group(2).strip()))
        elif section == "Claims":
            m = CLAIM_RE.match(line)
            if m:
                plan.claims.append(
                    Claim(
                        cid=m.group(1),
                        typ=m.group(3),
                        acs=parse_ac_list(m.group(4)),
                        text=m.group(5).strip(),
                        superseded=m.group(2) == "superseded",
                    )
                )
        elif section == "Preserve":
            if PRESERVE_NONE in line:
                plan.preserve_none = True
            m = PRESERVE_ITEM_RE.match(line)
            if m:
                plan.preserve.append(
                    PreserveItem(m.group(1), m.group(2), m.group(3).strip())
                )
        elif section == "Evidence packet":
            p = PACKET_PATH_RE.match(line)
            if p:
                plan.evidence_path = p.group(1)
            g = GAP_MAP_RE.match(line)
            if g:
                plan.gaps.append(GapMap(g.group(1), g.group(2)))
            pv = PRESERVE_MAP_RE.match(line)
            if pv:
                plan.preserve_maps.append(
                    PreserveItem(pv.group(1), pv.group(2), "")
                )
    return plan


def active_claims(plan: Plan) -> list[Claim]:
    return [c for c in plan.claims if not c.superseded]


def judgment_ratio(claims: list[Claim]) -> float:
    if not claims:
        return 0.0
    n = sum(1 for c in claims if c.typ == "judgment")
    return n / len(claims)


def uncovered_acs(plan: Plan) -> list[str]:
    covered: set[str] = set()
    for claim in active_claims(plan):
        covered.update(claim.acs)
    return [a.aid for a in plan.acs if a.aid not in covered]


def orphan_claims(plan: Plan) -> list[str]:
    known = {a.aid for a in plan.acs}
    out = []
    for claim in active_claims(plan):
        if not claim.acs or any(ac not in known for ac in claim.acs):
            out.append(claim.cid)
    return out


def duplicate_ids(plan: Plan) -> list[str]:
    seen: set[str] = set()
    dups: list[str] = []
    for claim in plan.claims:
        if claim.cid in seen:
            dups.append(claim.cid)
        seen.add(claim.cid)
    return dups


def mechanical_without_check(plan: Plan) -> list[str]:
    return [
        c.cid
        for c in active_claims(plan)
        if c.typ == "mechanical" and "→" not in c.text
    ]


def preserve_union(plan: Plan) -> list[PreserveItem]:
    by_id: dict[str, PreserveItem] = {}
    for item in plan.preserve:
        by_id[item.pid] = item
    for item in plan.preserve_maps:
        by_id.setdefault(item.pid, item)
    return list(by_id.values())


def unmapped_preserve(plan: Plan) -> list[str]:
    active = {c.cid for c in active_claims(plan)}
    return [p.pid for p in preserve_union(plan) if p.claim not in active]


def unmapped_gaps(plan: Plan) -> list[str]:
    active = {c.cid for c in active_claims(plan)}
    return [g.gid for g in plan.gaps if g.claim not in active]


def has_packet(plan: Plan) -> bool:
    return bool(plan.evidence_path or plan.gaps or plan.preserve_maps)


def required_sections_missing(plan: Plan) -> list[str]:
    needed = (
        "Phases",
        "Acceptance Criteria",
        "Claims",
        "Preserve",
        "Unresolved questions",
    )
    have = set(plan.sections)
    return [s for s in needed if s not in have]


def status_failure(decl: Declaration) -> str | None:
    if decl.status == "applies":
        return None
    if decl.status.startswith(NA_PREFIX):
        if decl.status[len(NA_PREFIX):].strip():
            return None
        return f"applicability {decl.key}: `n/a` needs a reason"
    if re.match(r"n/a\s*[-–]", decl.status):
        return f"applicability {decl.key}: use an em dash: `{NA_PREFIX} <reason>`"
    return f"applicability {decl.key}: status must be `applies` or `{NA_PREFIX} <reason>`"


def applicability_failures(plan: Plan, topic_keys: frozenset[str] | None) -> list[str]:
    """Mechanical shape only. Whether an `n/a` is true is the gate's call."""
    if not topic_keys:
        return []
    if APPLICABILITY not in plan.sections:
        return [f"missing section ## {APPLICABILITY}"]
    fails: list[str] = []
    if "Phases" in plan.sections and plan.sections.index(APPLICABILITY) > plan.sections.index("Phases"):
        fails.append(f"## {APPLICABILITY} must come before ## Phases")
    fails.extend(f"malformed applicability line: {line}" for line in plan.malformed_declarations)
    seen: set[str] = set()
    for decl in plan.declarations:
        if decl.key in seen:
            fails.append(f"applicability {decl.key} declared more than once")
        seen.add(decl.key)
        if decl.key not in topic_keys:
            fails.append(f"applicability {decl.key} is not a disclosed topic")
        failure = status_failure(decl)
        if failure:
            fails.append(failure)
    fails.extend(f"applicability {k} is not declared" for k in sorted(topic_keys - seen))
    return fails


def rules_prefixes(text: str) -> tuple[dict[str, str], list[str]]:
    """Map prefix → book from one generated RULES.md, skipping applicability.

    Returns (prefixes, errors). Malformed or duplicate ids are errors.
    """
    prefixes: dict[str, str] = {}
    errors: list[str] = []
    seen: set[str] = set()
    topic = ""
    for line in text.splitlines():
        heading = RULES_TOPIC_RE.match(line)
        if heading:
            topic = heading.group(1)
            continue
        m = RULES_ID_LINE_RE.match(line)
        if not m:
            continue
        book, raw_id = m.group(1), m.group(2)
        ident = RULES_ID_RE.match(raw_id)
        if not ident:
            errors.append(f"{book}: malformed rule id {raw_id}")
            continue
        if raw_id in seen:
            errors.append(f"{book}: duplicate rule id {raw_id}")
        seen.add(raw_id)
        if topic != APPLICABILITY_TOPIC:
            prefixes.setdefault(ident.group(1), book)
    return prefixes, errors


def topic_keys_from_rules(texts: list[str]) -> tuple[frozenset[str], list[str]]:
    """Required applicability keys across disclosed books, plus collisions."""
    owner: dict[str, str] = {}
    errors: list[str] = []
    books_seen: set[str] = set()
    for index, text in enumerate(texts, start=1):
        prefixes, errs = rules_prefixes(text)
        errors.extend(errs)
        books = set(prefixes.values())
        errors.extend(f"book {b} disclosed more than once" for b in sorted(books & books_seen))
        books_seen |= books
        if not prefixes and not errs:
            errors.append(f"disclosed rules #{index} yield no topic keys")
        for prefix, book in prefixes.items():
            if prefix in owner and owner[prefix] != book:
                errors.append(f"prefix {prefix} claimed by both {owner[prefix]} and {book}")
                continue
            owner[prefix] = book
    return frozenset(owner), errors


def audit(
    plan: Plan,
    loc_threshold: int | None = None,
    topic_keys: frozenset[str] | None = None,
) -> list[str]:
    """Return human-readable failure lines. Empty means pass."""
    fails: list[str] = []
    if not plan.pbi:
        fails.append("missing `# Plan: <id>` heading")
    fails.extend(f"missing section ## {s}" for s in required_sections_missing(plan))
    fails.extend(applicability_failures(plan, topic_keys))
    if not plan.phases:
        fails.append("no ### Phase N heading")
    if not plan.acs:
        fails.append("no acceptance criteria")
    if not active_claims(plan):
        fails.append("no active claims")
    fails.extend(f"duplicate claim id {i}" for i in duplicate_ids(plan))
    fails.extend(f"AC {a} has no claim" for a in uncovered_acs(plan))
    fails.extend(f"claim {c} is orphan (no known AC)" for c in orphan_claims(plan))
    fails.extend(
        f"mechanical claim {c} has no `→` check" for c in mechanical_without_check(plan)
    )
    ratio = judgment_ratio(active_claims(plan))
    if ratio > JUDGMENT_QUOTA + 1e-12:
        fails.append(
            f"judgment quota {ratio:.0%} exceeds {JUDGMENT_QUOTA:.0%}"
        )
    if not plan.preserve_none and not plan.preserve:
        fails.append(
            "Preserve is empty — list what must survive, or "
            f"`{PRESERVE_NONE}`"
        )
    if plan.preserve_none and plan.preserve:
        fails.append("Preserve declares none but also lists items")
    if plan.preserve_none and plan.preserve_maps:
        fails.append("Preserve declares none but packet maps preserve items")
    mismatched: set[str] = set()
    if has_packet(plan):
        section_by = {p.pid: p for p in plan.preserve}
        map_by = {p.pid: p for p in plan.preserve_maps}
        for pid, mapped in map_by.items():
            item = section_by.get(pid)
            if item is None:
                if not plan.preserve_none:
                    fails.append(
                        f"packet preserve {pid} is not listed in ## Preserve"
                    )
                continue
            if item.claim != mapped.claim:
                fails.append(
                    f"preserve {pid} packet maps to {mapped.claim} "
                    f"but ## Preserve maps to {item.claim}"
                )
                mismatched.add(pid)
        for pid in section_by:
            if pid not in map_by:
                fails.append(
                    f"preserve {pid} listed in ## Preserve but packet has no preserve map"
                )
    fails.extend(
        f"preserve {p} maps to a missing/superseded claim"
        for p in unmapped_preserve(plan)
        if p not in mismatched
    )
    fails.extend(
        f"gap {g} maps to a missing/superseded claim" for g in unmapped_gaps(plan)
    )
    if (plan.gaps or plan.preserve_maps) and not plan.evidence_path:
        fails.append("evidence packet has maps but no path")
    if plan.evidence_path and not plan.gaps and not plan.preserve_maps:
        fails.append(
            "evidence packet present but no gap or preserve maps to claims"
        )
    if loc_threshold is not None:
        for phase in plan.phases:
            if phase.est_loc is None:
                fails.append(f"phase {phase.num} has no `- est. LOC: <n>` line")
            elif phase.est_loc > loc_threshold:
                fails.append(
                    f"phase {phase.num} est. LOC {phase.est_loc} "
                    f"exceeds {loc_threshold}"
                )
    return fails


def audit_text(
    text: str,
    loc_threshold: int | None = None,
    topic_keys: frozenset[str] | None = None,
) -> list[str]:
    return audit(parse_plan(text), loc_threshold=loc_threshold, topic_keys=topic_keys)


def catalog_cross_cutting_rules() -> list[Path]:
    """Action: the cross-cutting books' RULES.md in the catalog holding this script."""
    root = Path(__file__).resolve().parent.parent
    spec = importlib.util.spec_from_loader(
        "extract_rules",
        importlib.machinery.SourceFileLoader("extract_rules", str(root / "scripts" / "extract-rules")),
    )
    extract_rules = importlib.util.module_from_spec(spec)
    assert spec.loader is not None
    spec.loader.exec_module(extract_rules)
    books = extract_rules.discover_books(root / ".agents" / "skills")
    return [
        book / "RULES.md"
        for book in books
        if extract_rules.book_scope(book / "SKILL.md") == "cross-cutting"
    ]


def is_cross_cutting_rules(rules: Path) -> bool:
    """Action: a RULES.md beside a book card must come from a cross-cutting book.

    A file with no sibling SKILL.md (a disclosed copy) is judged by its ids alone.
    """
    card = rules.parent / "SKILL.md"
    if not card.is_file():
        return True
    match = re.search(r"(?m)^\s*scope:\s*[\"']?([\w-]+)", card.read_text())
    return bool(match) and match.group(1) == "cross-cutting"


def parse_argv(args: list[str]) -> tuple[str, int | None, list[str]] | None:
    """Return (path, loc_threshold, rules) or None on usage error."""
    loc_threshold: int | None = None
    path: str | None = None
    rules: list[str] = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--rules":
            if i + 1 >= len(args) or args[i + 1].startswith("-"):
                return None
            rules.append(args[i + 1])
            i += 2
            continue
        if arg == "--loc-threshold":
            if loc_threshold is not None or i + 1 >= len(args):
                return None
            try:
                loc_threshold = int(args[i + 1])
            except ValueError:
                return None
            i += 2
            continue
        if arg.startswith("-") or path is not None:
            return None
        path = arg
        i += 1
    if path is None:
        return None
    return path, loc_threshold, rules


def main(argv: list[str]) -> int:
    parsed = parse_argv(argv[1:])
    if parsed is None:
        print(
            "usage: audit-plan [--loc-threshold N] [--rules RULES.md ...] <plan.md>",
            file=sys.stderr,
        )
        return 2
    raw_path, loc_threshold, raw_rules = parsed
    path = Path(raw_path)
    if not path.is_file():
        print(f"✗ {path} is not a file", file=sys.stderr)
        return 1
    rules_paths = [Path(r) for r in raw_rules] or catalog_cross_cutting_rules()
    missing = [r for r in rules_paths if not r.is_file()]
    if missing:
        print(f"✗ rules file not found: {', '.join(map(str, missing))}", file=sys.stderr)
        return 1
    not_cross_cutting = [r for r in rules_paths if not is_cross_cutting_rules(r)]
    if not_cross_cutting:
        print(
            f"✗ not a cross-cutting book's RULES.md: {', '.join(map(str, not_cross_cutting))}",
            file=sys.stderr,
        )
        return 1
    topic_keys, rule_errors = topic_keys_from_rules([r.read_text() for r in rules_paths])
    if rule_errors:
        print("✗ disclosed cross-cutting rules are malformed")
        for line in rule_errors:
            print(f"  - {line}")
        return 1
    fails = audit_text(path.read_text(), loc_threshold=loc_threshold, topic_keys=topic_keys)
    if fails:
        print(f"✗ {path}: {len(fails)} plan-audit failure(s)")
        for line in fails:
            print(f"  - {line}")
        return 1
    print(f"✓ {path}: plan audit pass")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
