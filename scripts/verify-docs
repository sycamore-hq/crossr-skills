#!/usr/bin/env bash
#
# verify-docs
# Catalog-only verification of crossr-skills.
#
# Usage:
#   ./scripts/verify-docs                # Run checks and print results
#   ./scripts/verify-docs --html         # Run checks + generate self-contained HTML report
#
# Public skill catalog SSOT: docs/public-skills.json
# README skills table must match the allowlist.
# Moved conductors/harness skills must not reappear here (split-07 cut).
#
# The HTML report is written to docs/docs-verification-report.html

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

GENERATE_HTML=false
if [[ "${1:-}" == "--html" ]]; then
    GENERATE_HTML=true
fi

FAILED=0
REPORT_LINES=()

pass() {
    echo "  ✓ $1"
    REPORT_LINES+=("pass|$1")
}

fail() {
    echo "  ✗ $1"
    REPORT_LINES+=("fail|$1")
    FAILED=1
}

PUBLIC_SKILLS_JSON="docs/public-skills.json"

# Product source of these names lives in loops or harness. Must not return here.
# crossr-review is a conductor from the loops pin and is deliberately NOT listed:
# it reviews pull requests, including this repo's own. Usable here, unpublished.
# See the orchestration-skills paragraph in AGENTS.md before adding it.
GONE='["avril","axel","brick","rust-team-lead","orchestrator-prompt","dashboard-prompt","chief-of-staff"]'

load_allowlist() {
    if [[ ! -f "$PUBLIC_SKILLS_JSON" ]]; then
        fail "missing $PUBLIC_SKILLS_JSON"
        return 1
    fi
    python3 - "$PUBLIC_SKILLS_JSON" "$GONE" <<'PY'
import json, sys
path, gone_json = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
assert "version" in data and "skills" in data and "out" in data
names = [s["name"] for s in data["skills"]]
assert len(names) == len(set(names)), "duplicate skill names"
gone = set(json.loads(gone_json))
overlap = [n for n in names if n in gone]
assert not overlap, f"moved skills still in catalog: {overlap}"
for s in data["skills"]:
    assert "name" in s and "category" in s and "purpose" in s
    assert "moved-to" not in s, s["name"]
for o in data["out"]:
    assert "name" in o and "reason" in o
featured = data.get("featured", [])
for f in featured:
    assert f in names, f"featured not in catalog: {f}"
    assert f not in gone, f"featured moved skill: {f}"
print("\n".join(names))
PY
}

echo "→ Running catalog verification..."

echo ""
echo "Checking project docs..."

if grep -q "canonical portable structure" AGENTS.md; then
    pass "AGENTS.md references canonical portable structure"
else
    fail "AGENTS.md missing canonical portable structure"
fi

echo ""
echo "Checking public skills allowlist..."

ALLOWLIST=""
if ALLOWLIST=$(load_allowlist 2>/dev/null); then
    pass "$PUBLIC_SKILLS_JSON schema and unique names OK"
    COUNT=$(echo "$ALLOWLIST" | grep -c . || true)
    missing=0
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        skill_path=".agents/skills/$name/SKILL.md"
        if [[ ! -s "$skill_path" ]]; then
            fail "allowlisted skill missing or empty: $skill_path"
            missing=1
        fi
    done <<< "$ALLOWLIST"
    if [[ $missing -eq 0 ]]; then
        pass "every allowlisted skill has non-empty SKILL.md (N=$COUNT)"
    fi
else
    fail "$PUBLIC_SKILLS_JSON invalid or missing"
    load_allowlist || true
    ALLOWLIST=""
    COUNT=0
fi

echo ""
echo "Checking moved artifacts stay gone..."
if python3 - "$GONE" <<'PY'
import json, os, sys
gone = json.loads(sys.argv[1])
failed = 0
for name in gone:
    path = f".agents/skills/{name}/SKILL.md"
    if os.path.isfile(path) and os.path.getsize(path) > 0:
        print(f"  still present: {path}", file=sys.stderr)
        failed = 1
sys.exit(failed)
PY
then
    pass "moved skill directories absent (7 names)"
else
    fail "moved skill directories still present"
fi

extract_readme_skills() {
    python3 - <<'PY'
import re
from pathlib import Path
text = Path("README.md").read_text()
names = re.findall(r"^\|\s*`([a-z0-9-]+)`\s*\|", text, re.M)
print("\n".join(names))
PY
}

set_eq() {
    python3 - "$1" "$2" <<'PY'
import sys
a = set(filter(None, sys.argv[1].splitlines()))
b = set(filter(None, sys.argv[2].splitlines()))
if a == b:
    sys.exit(0)
print("only_allowlist", sorted(a-b))
print("only_readme", sorted(b-a))
sys.exit(1)
PY
}

if [[ -n "$ALLOWLIST" ]]; then
    README_SKILLS=$(extract_readme_skills)
    if set_eq "$ALLOWLIST" "$README_SKILLS"; then
        pass "README skills table == public allowlist"
    else
        fail "README skills table does not match public allowlist"
        set_eq "$ALLOWLIST" "$README_SKILLS" || true
    fi
fi

echo ""
echo "Checking stub / out-set names are not marketed..."
STUBS="diataxis-explanation diataxis-how-to-guides diataxis-reference"
for stub in $STUBS; do
    hits=$(grep -n --include="*.md" --include="*.html" -e "$stub" README.md docs/public-skills.json 2>/dev/null || true)
    bad=$(echo "$hits" | grep -viE 'stub|out|deferred|not in|empty|not marketed|not a shippable' || true)
    if [[ -n "$bad" ]]; then
        fail "stub name marketed on public surface: $stub"
        echo "$bad"
    else
        pass "stub $stub only mentioned as non-public"
    fi
done

generate_html_report() {
    REPORT_PATH="docs/docs-verification-report.html"
    mkdir -p docs
    STATUS_LABEL="PASS"
    STATUS_CLASS="bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
    STATUS_ICON="fa-check"
    if [[ $FAILED -ne 0 ]]; then
        STATUS_LABEL="FAIL"
        STATUS_CLASS="bg-red-500/10 text-red-400 border-red-500/20"
        STATUS_ICON="fa-xmark"
    fi

    {
        cat <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalog Verification Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-zinc-950 text-zinc-200">
    <div class="max-w-4xl mx-auto px-6 py-12">
        <div class="flex items-center justify-between mb-8">
            <div>
                <div class="text-3xl font-semibold tracking-tighter">Catalog Verification</div>
                <div class="text-sm text-zinc-400">crossr-skills · public-skills allowlist</div>
            </div>
            <div class="px-4 py-1.5 rounded-3xl text-sm font-semibold flex items-center gap-x-2 border ${STATUS_CLASS}">
                <i class="fa-solid ${STATUS_ICON}"></i>
                <span>${STATUS_LABEL}</span>
            </div>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-6 space-y-2 text-sm">
EOF
        for line in "${REPORT_LINES[@]}"; do
            kind="${line%%|*}"
            msg="${line#*|}"
            if [[ "$kind" == "pass" ]]; then
                echo "<div class=\"flex gap-3 p-2\"><i class=\"fa-solid fa-check text-emerald-400 mt-0.5\"></i><span>${msg}</span></div>"
            elif [[ "$kind" == "fail" ]]; then
                echo "<div class=\"flex gap-3 p-2\"><i class=\"fa-solid fa-xmark text-red-400 mt-0.5\"></i><span>${msg}</span></div>"
            else
                echo "<div class=\"flex gap-3 p-2 text-zinc-500\"><span>${msg}</span></div>"
            fi
        done
        cat <<EOF
        </div>
    </div>
</body>
</html>
EOF
    } > "$REPORT_PATH"
    echo ""
    echo "  → HTML report generated at $REPORT_PATH ($STATUS_LABEL)"
}

echo ""
if [[ $FAILED -eq 0 ]]; then
    echo "✓ All catalog verification checks passed."
else
    echo "✗ Catalog verification failed."
fi

if [[ "$GENERATE_HTML" = true ]]; then
    generate_html_report
fi

exit $FAILED
